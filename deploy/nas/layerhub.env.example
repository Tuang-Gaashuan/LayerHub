# systemd reads this file; the Go binary does not automatically read .env.
LAYERHUB_ADDRESS=127.0.0.1:5181
LAYERHUB_DATA_DIR=/var/lib/layerhub/data
LAYERHUB_WEB_DIR=/opt/layerhub/current/web
LAYERHUB_DEVICE_MODE=offline
LAYERHUB_ENABLE_PRINT_START=0
LAYERHUB_ADMIN_USER=admin
LAYERHUB_MAX_UPLOAD_MB=500
# Set 1 only after the public HTTPS gateway is ready; localhost HTTP testing uses 0.
LAYERHUB_COOKIE_SECURE=0
# Replace with your public HTTPS origin when enabling email.
# LAYERHUB_PUBLIC_URL=https://print.example.com/
# Optional first-run password. Unset generates data/bootstrap-admin.txt.
# LAYERHUB_ADMIN_PASSWORD=
# Optional mail relay: random token shared privately with your own cloud worker.
# LAYERHUB_MAIL_TOKEN=
